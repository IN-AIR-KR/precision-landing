<?xml version="1.0"?>
<package format="3">
  <name>pl_detection</name><version>0.0.1</version>
  <description>Python ArUco detector</description>
  <maintainer email="jake@arkelectron.com">Precision Landing Maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>python3-numpy</exec_depend>
  <!-- OpenCV headless wheel is pinned in requirements-detection.txt. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
