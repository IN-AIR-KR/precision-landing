<?xml version="1.0"?>
<package format="3">
  <name>pl_logging</name>
  <version>0.0.1</version>
  <description>Precision landing rosbag recorder</description>
  <maintainer email="jake@arkelectron.com">Precision Landing Maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
