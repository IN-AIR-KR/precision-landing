<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pl_viz</name>
  <version>0.0.1</version>
  <description>Common precision landing camera and telemetry monitor</description>
  <maintainer email="jake@arkelectron.com">Jacob Dahl</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>

  <!-- ROS2 Dependencies -->
  <depend>geometry_msgs</depend>

  <!-- Gazebo Dependencies (simulation only) -->
  <!-- Optional PL_VIZ_GAZEBO build uses system gz-transport13 / gz-msgs10. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>pl_detection</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
