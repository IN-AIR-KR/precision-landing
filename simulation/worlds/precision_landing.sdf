<?xml version="1.0" encoding="UTF-8"?>
<!--
  precision_landing.sdf
  정밀착륙 시뮬레이션 월드

  - 원점(0,0)에 V-마커(3×3m) 배치
  - 드론은 PX4_GZ_MODEL_POSE="0,0,0.5,0,0,0" 환경변수로 지상 근처에 스폰
  - 이륙 후 35m 고도에서 착륙 시퀀스 시작
  - 실행 예:
      export GZ_SIM_RESOURCE_PATH=/path/to/precision-landing/simulation/models:$GZ_SIM_RESOURCE_PATH
      PX4_GZ_MODEL_POSE="0,0,0.5,0,0,0" PX4_GZ_WORLD=precision_landing make px4_sitl gz_x500_mono_cam_down
-->
<sdf version="1.9">
  <world name="precision_landing">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 지면 플레인 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 태양광 -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- 구면 좌표 (취리히 기준 PX4 기본값) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- V-마커 (3×3m) — 원점에 배치 -->
    <include>
      <uri>model://v_marker</uri>
      <pose>0 0 0.001 0 0 0</pose>
    </include>

  </world>
</sdf>
