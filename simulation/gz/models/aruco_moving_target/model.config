<?xml version="1.0"?>
<model>
  <name>aruco_moving_target</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Flat pad carrying the ArUco tag used by aruco_tracker. Rests on the ground via normal
    gravity/contact and is driven by Gazebo's stock VelocityControl plugin: stationary until
    a velocity is published on /model/aruco_moving_target/cmd_vel.
  </description>
</model>
