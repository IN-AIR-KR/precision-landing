<?xml version="1.0"?>
<model>
  <name>aruco_moving_target</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    4-wheeled vehicle chassis carrying the ArUco tag used by aruco_tracker. Driven by Gazebo's
    stock DiffDrive plugin via real wheel-ground friction (wheels actually roll): stationary
    until a velocity is published on /model/aruco_moving_target/cmd_vel.
  </description>
</model>
