<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="aruco_moving_target">
    <!--
      Chassis on 4 wheels, driven by Gazebo's DiffDrive plugin via real wheel-ground friction
      (not a force/velocity hack): the wheel joints are spun up to match the commanded body
      velocity, so the wheels visibly roll and the vehicle actually needs traction to move.
      Stays stationary until you publish a velocity command (default = zero velocity):

        gz topic -t "/model/aruco_moving_target/cmd_vel" -m gz.msgs.Twist -p "linear: {x: 1.0}"
        gz topic -t "/model/aruco_moving_target/cmd_vel" -m gz.msgs.Twist -p "linear: {x: 0, y: 0}"  # stop
    -->
    <link name="chassis">
      <pose>0 0 0.475 0 0 0</pose>
      <inertial>
        <mass>300</mass>
        <inertia>
          <ixx>56.8125</ixx>
          <iyy>56.8125</iyy>
          <izz>112.5</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>1.5 1.5 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>1.5 1.5 0.15</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode/>
          </friction>
          <bounce/>
          <contact/>
        </surface>
      </collision>
      <!-- ArUco tag on top of the chassis. Size must match aruco_tracker's marker_size param (1.0m). -->
      <visual name="aruco_tag_visual">
        <pose>0 0 0.077 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1.0 1.0</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_moving_target/arucotag.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <!-- 4 wheels: cylinders rolling about their local Z axis, which the -90deg roll in <pose>
         lines up with world Y (perpendicular to forward/X travel). Same convention as Gazebo's
         own diff_drive.sdf example. -->
    <link name="wheel_front_left">
      <pose>0.55 0.65 0.2 -1.5707963 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.0325</ixx>
          <iyy>0.0325</iyy>
          <izz>0.06</izz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <!-- Dry asphalt + rubber tire ≈ 0.7-0.9; using a representative 0.8 (default
                 Gazebo friction of 1.0 is unrealistically grippier than real tarmac). -->
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="wheel_front_right">
      <pose>0.55 -0.65 0.2 -1.5707963 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.0325</ixx>
          <iyy>0.0325</iyy>
          <izz>0.06</izz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="wheel_rear_left">
      <pose>-0.55 0.65 0.2 -1.5707963 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.0325</ixx>
          <iyy>0.0325</iyy>
          <izz>0.06</izz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="wheel_rear_right">
      <pose>-0.55 -0.65 0.2 -1.5707963 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.0325</ixx>
          <iyy>0.0325</iyy>
          <izz>0.06</izz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="wheel_front_left_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_front_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="wheel_front_right_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_front_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="wheel_rear_left_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_rear_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="wheel_rear_right_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_rear_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_rear_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_rear_right_joint</right_joint>
      <wheel_separation>1.3</wheel_separation>
      <wheel_radius>0.2</wheel_radius>
      <max_linear_acceleration>3</max_linear_acceleration>
      <min_linear_acceleration>-3</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>
      <max_linear_velocity>20</max_linear_velocity>
      <min_linear_velocity>-20</min_linear_velocity>
      <max_angular_velocity>1</max_angular_velocity>
      <min_angular_velocity>-1</min_angular_velocity>
    </plugin>
  </model>
</sdf>
