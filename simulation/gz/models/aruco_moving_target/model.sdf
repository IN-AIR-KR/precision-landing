<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="aruco_moving_target">
    <!--
      Flat pad sitting on the ground (normal gravity + ground contact, not force-held in the air).
      Stays stationary until you publish a velocity command (default = zero velocity):

        gz topic -t "/model/aruco_moving_target/cmd_vel" -m gz.msgs.Twist -p "linear: {x: 1.0}"
        gz topic -t "/model/aruco_moving_target/cmd_vel" -m gz.msgs.Twist -p "linear: {x: 0, y: 0}"  # stop
    -->
    <link name="marker_link">
      <pose>0 0 0.051 0 0 0</pose>
      <inertial>
        <mass>50</mass>
        <inertia>
          <ixx>9.42</ixx>
          <iyy>9.42</iyy>
          <izz>18.75</izz>
        </inertia>
      </inertial>
      <visual name="platform_visual">
        <geometry>
          <box>
            <size>1.5 1.5 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="platform_collision">
        <geometry>
          <box>
            <size>1.5 1.5 0.1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode/>
          </friction>
          <bounce/>
          <contact/>
        </surface>
      </collision>
      <!-- ArUco tag on top of the platform. Size must match aruco_tracker's marker_size param (1.0m). -->
      <visual name="aruco_tag_visual">
        <pose>0 0 0.052 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1.0 1.0</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_moving_target/arucotag.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <!-- Stock Gazebo plugin: sets the model's velocity from a runtime /model/<name>/cmd_vel topic.
         No command received yet => zero velocity => stays put. -->
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
    </plugin>
  </model>
</sdf>
