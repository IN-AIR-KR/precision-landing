<?xml version="1.0" encoding="UTF-8"?>
<!--
  V-마커 Gazebo 모델 (3×3m 평면)
  텍스처 파일: v_marker.png (scripts/generate_marker_texture.py 로 생성)
-->
<sdf version="1.9">
  <model name="v_marker">
    <static>true</static>
    <link name="base">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>3 3</size>
          </plane>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>3 3</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://v_marker/v_marker.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
